# Copy this file to .env and fill in your values

# From Neon.tech — your database connection string
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth secret — any long random string (just mash your keyboard)
AUTH_SECRET=change-this-to-any-long-random-string-at-least-32-chars

# The URL where the web app runs locally
AUTH_URL=http://localhost:3000
